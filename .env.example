# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
#
# The schema uses the "postgresql" provider (persists across serverless invocations
# on Vercel; SQLite does not). Use a Postgres URL here — e.g. Vercel Postgres, Neon,
# or Supabase. On Vercel, add DATABASE_URL as a project env var. After setting it,
# create the tables with:  npx prisma db push
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Signs the admin session cookie. Change this to a long random string in production.
SESSION_SECRET=

# Default admin account created by `npm run db:seed`. Change the password after first login.
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=

# DeepSeek API key, used to verify OCR'd lab-completion screenshots (see /api/labs/verify-screenshot).
# Get one at https://platform.deepseek.com. Leave blank to disable AI verification (falls back to OCR-only heuristic).
DEEPSEEK_API_KEY=
