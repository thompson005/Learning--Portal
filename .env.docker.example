# Copy to a file named `.env` in this folder before running docker compose.
# docker compose reads these to fill ${...} in docker-compose.yml.

# Database (used by both the db service and the app's DATABASE_URL)
POSTGRES_PASSWORD=change-me-to-a-strong-password

# App secrets
SESSION_SECRET=change-me-to-a-long-random-string
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-to-a-strong-admin-password

# Optional: AI screenshot verification for labs. Leave blank to disable.
DEEPSEEK_API_KEY=

# AI tutor (local LLM). Defaults point at the bundled `ollama` service — no
# change needed for the standard compose. After `docker compose up`, pull the
# model once:  docker compose exec ollama ollama pull llama3.2:3b
# Use a bigger model (e.g. llama3.1:8b) on the DGX for better answers.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# Lab scheduling + per-container resource limits (size to the host).
# One user runs one lab at a time; MAX_CONCURRENT caps the whole box.
LABS_MAX_CONCURRENT=24
LABS_MEM=512m
LABS_CPUS=1
LABS_PIDS=256
LABS_PORT_MIN=18100
LABS_PORT_MAX=18160

# VPN-only hosting: set to the DGX's own VPN (WireGuard) IP, e.g. 10.8.0.5.
# The portal and all lab target ports then bind ONLY to that IP, so the site is
# reachable only by clients connected to the VPN. Leave blank for all interfaces.
BIND_IP=

# Host port for the portal. Set to 80 so users can type a bare hostname with no
# :port (e.g. http://lms.technieum.net). Default 3000.
WEB_PORT=3000
