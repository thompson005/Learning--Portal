// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres for persistent, multi-user hosting (e.g. on Vercel with Neon /
  // Vercel Postgres). For purely local dev you can switch this to "sqlite" and
  // set DATABASE_URL="file:./dev.db".
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

// A learner account. Progress is stored as a JSON blob synced from the client
// store, keyed to the user, so it survives across devices and browsers.
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  progressJson String        @default("{}")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastLoginAt  DateTime?
  lastSeenAt   DateTime?
  sessions     UserSession[]
  activity     ActivityDay[]
}

// Per-learner, per-day time-on-portal, captured automatically from a client
// heartbeat (only while the tab is visible and focused). Replaces the manual
// "Number of hours" column of the old daily-learning-log spreadsheet.
model ActivityDay {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  day           String   // yyyy-mm-dd in the learner's local date
  activeSeconds Int      @default(0)
  sessions      Int      @default(1)
  firstAt       DateTime @default(now())
  lastAt        DateTime @default(now())

  @@unique([userId, day])
  @@index([userId])
}

model UserSession {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Session {
  id          String    @id @default(cuid())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  adminUserId String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}

model Trainee {
  id           String                @id @default(cuid())
  name         String
  createdAt    DateTime              @default(now())
  moduleStatus TraineeModuleStatus[]
}

model TraineeModuleStatus {
  id        String   @id @default(cuid())
  trainee   Trainee  @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  traineeId String
  moduleId  String
  status    Int      @default(0) // 0 = not started, 1 = in progress, 2 = completed
  updatedAt DateTime @updatedAt

  @@unique([traineeId, moduleId])
}

model LabRun {
  id            String    @id @default(cuid())
  userId        String?   // the learner who started this lab — one running lab per user
  labId         String
  containerName String
  containerId   String?
  port          Int?
  status        String    @default("running") // running | stopped | failed
  errorMessage  String?
  startedAt     DateTime  @default(now())
  stoppedAt     DateTime?

  @@index([userId])
  @@index([status])
}
