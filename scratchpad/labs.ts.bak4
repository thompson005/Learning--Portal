      },
      {
        title: "UNION attack to dump credentials",
        body: "ORDER BY 1, ORDER BY 2, etc. incrementally finds the exact column count without an error, after which UNION SELECT username, password FROM users-- - is sent once the text-compatible columns are known, dumping every user's credentials.",
        diagram: {
          type: "flow-chain",
          steps: [
            {
              label: "ORDER BY 1, 2, 3...",
              detail: "increase until the query errors to find column count",
            },
            {
              label: "UNION SELECT username, password FROM users-- -",
              detail: "credentials dumped into the response",
            },
          ],
        },
      },
      {
        title: "Blind SQLi via conditional responses",
        body: "The injection point is confirmed by comparing responses to a TrackingId cookie payload that evaluates true (' AND '1'='1) versus false (' AND '1'='2); Burp Intruder then runs a Simple-list of characters with a Grep-Match on the true-condition response to extract the administrator password one character at a time via SUBSTRING.",
        diagram: {
          type: "request-response",
          leftLabel: "Intruder (TrackingId cookie)",
          rightLabel: "Lab server",
          exchanges: [
            {
              direction: "right",
              label: "true probe",
              payload: "' AND '1'='1",
            },
            {
              direction: "left",
              label: "normal response",
              payload: "true-condition signature present",
            },
            {
              direction: "right",
              label: "false probe",
              payload: "' AND '1'='2",
            },
            {
              direction: "left",
              label: "different response",
              payload: "true-condition signature absent",
            },
            {
              direction: "right",
              label: "char extraction",
              payload: "SUBSTRING(password,1,1)='a' ...",
            },
          ],
