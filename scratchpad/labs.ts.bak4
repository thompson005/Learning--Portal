    slides: [
      {
        title: "IDOR via a predictable filename",
        body: "Using the Live chat widget and clicking 'View transcript' produces a URL ending in a numbered filename like /chat/2.txt; changing the number down to /chat/1.txt reads another user's (carlos's) transcript directly, and the leaked password inside it is used to log in as carlos.",
        diagram: {
          type: "request-response",
          leftLabel: "Browser",
