        title: "PortSwigger Web Academy: SQL injection",
        url: "https://portswigger.net/web-security/sql-injection",
        type: "link",
      },
    ],
    completionIndicator: `PortSwigger green 'Congratulations, you solved this lab!' banner captured individually for each of the three named labs, plus a Repeater screenshot showing the dumped username/password columns from the UNION attack lab.`,
    slides: [
      {
        title: "Bypass the WHERE clause",
        body: "On 'SQL injection vulnerability in WHERE clause allowing retrieval of hidden data', sending the category filter request to Repeater and injecting category=Gifts' OR 1=1-- - bypasses the released=1 condition, revealing unreleased products.",
        diagram: {
          type: "request-response",
          leftLabel: "Repeater",
