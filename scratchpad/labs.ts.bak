      { title: "Python socket module docs", url: "https://docs.python.org/3/library/socket.html", type: "link" },
    ],
    completionIndicator:
      `Terminal screenshot of subbrute.py's output listing discovered live subdomains (hostname, scheme, status code) for the test domain, next to the script's source code.`,
