      { title: "Hashcat rule-based attack wiki", url: "https://hashcat.net/wiki/doku.php?id=rule_based_attack", type: "link" },
      { title: "SecLists (wordlists incl. rockyou variants)", url: "https://github.com/danielmiessler/SecLists", type: "tool" },
