    resources: [
      { title: "Python socket module docs", url: "https://docs.python.org/3/library/socket.html", type: "link" },
      { title: "Python concurrent.futures docs", url: "https://docs.python.org/3/library/concurrent.futures.html", type: "link" },
      { title: "Metasploitable2 (legal local scan target)", url: "https://sourceforge.net/projects/metasploitable/files/Metasploitable2/", type: "tool" },
      { title: "Nmap official docs", url: "https://nmap.org/book/man.html", type: "link" },
    ],
    completionIndicator:
      `Terminal screenshot of scanner.py's output listing open ports on the target, placed alongside the equivalent \`nmap -p-\` output for the same host, plus the script's source file.`,
  },
