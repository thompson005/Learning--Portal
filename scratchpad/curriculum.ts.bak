import type { Module } from "@/types"

export const CURRICULUM: Module[] = [
  // ============================================================
  // M0: Computer Hardware Basics
  // ============================================================
  {
    id: "m0",
    name: "M0: Computer Hardware Basics",
    shortName: "Hardware Basics",
    month: 1,
    weeks: [1],
    description:
      "Foundational hardware knowledge every security professional needs — how a computer's core components work together, from silicon to boot screen. This underpins later topics like buffer overflows, memory forensics, and boot-level attacks (bootkits, Secure Boot bypass).",
    estimatedHours: 6,
    outcomes: [
      "Explain the role of the CPU, RAM, ROM, and storage in a running system",
      "Distinguish HDD, SSD, and NVMe storage and their security implications",
      "Describe what BIOS/UEFI do and how Secure Boot protects the boot chain",
      "Walk through what happens, component by component, from power-on to OS load",
    ],
    resources: [
      { title: "Professor Messer: Hardware Basics", url: "https://www.professormesser.com", type: "video" },
      { title: "NIST SP 800-12", url: "https://csrc.nist.gov", type: "link" },
    ],
    topics: [
      {
        id: "m0-1",
        moduleId: "m0",
        number: 1,
        title: "What is a CPU (Central Processing Unit)?",
        type: "theory",
        week: 1,
        description:
          "The CPU is the computer's 'brain' — it fetches, decodes, and executes instructions one cycle at a time. Understanding it is essential background for buffer overflows and process/CPU-based attacks later in the course.",
        keyPoints: [
          "Fetch-decode-execute cycle is the core of CPU operation",
          "Registers hold data the CPU is actively working on (including the instruction pointer / EIP-RIP)",
          "Cores and clock speed (GHz) determine how many instructions run per second",
          "A buffer overflow exploit works by overwriting a return address, hijacking the CPU's instruction pointer",
        ],
      },
      {
        id: "m0-2",
        moduleId: "m0",
        number: 2,
        title: "RAM vs ROM — Volatile vs Non-Volatile Memory",
        type: "theory",
        week: 1,
        description:
          "RAM and ROM sit at opposite ends of the volatility spectrum — one is fast but forgets everything on power loss, the other is slow but permanent. This distinction matters directly for memory forensics (RAM dumps) and firmware security (ROM/EEPROM).",
        keyPoints: [
          "RAM (volatile): holds data/programs currently in use by the CPU; wiped on power-off",
          "ROM (non-volatile): retains firmware (e.g. BIOS/UEFI) even without power",
          "Forensic RAM dumps can recover encryption keys, passwords, and running-process artefacts",
          "EEPROM (a type of ROM) is why BIOS settings survive a reboot",
        ],
      },
      {
        id: "m0-3",
        moduleId: "m0",
        number: 3,
        title: "Storage Types: HDD, SSD, NVMe",
        type: "theory",
        week: 1,
        description:
          "Storage technology has evolved from spinning magnetic platters to solid-state chips connected directly to the CPU bus — each generation trades off speed, cost, and forensic recoverability differently.",
        keyPoints: [
          "HDD: spinning magnetic platters, slowest, cheapest per GB, deleted data often recoverable (no true erase)",
          "SSD: flash memory chips, no moving parts, much faster than HDD, uses TRIM/wear-levelling that complicates forensic recovery",
          "NVMe: SSD connected directly over PCIe instead of SATA — dramatically higher throughput and lower latency",
          "Full-disk encryption (BitLocker/LUKS) matters more on SSD/NVMe since deleted data is harder to reliably wipe",
        ],
      },
      {
        id: "m0-4",
        moduleId: "m0",
        number: 4,
        title: "GPU, Motherboard, BIOS/UEFI Explained",
        type: "theory",
        week: 1,
        description:
          "BIOS and UEFI are the firmware interfaces that initialise all this hardware and load the OS; UEFI is the modern, more secure replacement for legacy BIOS.",
        keyPoints: [
          "GPU: specialised parallel processor for graphics/rendering, also used for password cracking (Hashcat) due to parallelism",
          "Motherboard: connects CPU, RAM, storage, and peripherals via buses",
          "BIOS uses MBR partitioning (max ~2TB, 4 primary partitions) with a text-only interface",
          "UEFI uses GPT partitioning (supports >2TB), has a GUI, and supports Secure Boot",
          "POST (Power-On Self-Test) checks hardware before the boot loader runs",
          "Secure Boot blocks unsigned bootloader code — stops bootkits persisting through a reimage",
        ],
      },
      {
        id: "m0-5",
        moduleId: "m0",
        number: 5,
        title: "How hardware components interact at boot time",
        type: "theory",
        week: 1,
        description:
          "The boot process is a strict hand-off chain: firmware (BIOS/UEFI) to boot loader to kernel to init system — each stage verifying and launching the next.",
        keyPoints: [
          "POST → BIOS/UEFI reads MBR/GPT → boot loader (GRUB / Windows Boot Manager) loads",
          "Boot loader loads the kernel image into memory; kernel sets up memory management/paging and loads drivers",
          "Kernel mounts the root filesystem then starts the init process (PID 1)",
          "Modern Linux uses systemd (targets) instead of legacy SysV init/runlevels",
        ],
        terminalCommands: [
          "dmesg | less",
          "systemctl get-default",
          "systemctl list-units --type=service --state=running",
          "bootrec /fixmbr",
          "bootrec /rebuildbcd",
        ],
      },
    ],
  },

  // ============================================================
